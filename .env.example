# Settings for the live tests in tests/live/. Copy to .env and fill in.
# Run with:  uv run --env-file .env pytest tests/live -s --no-cov
# No secret belongs in this file. App-flow tests use a certificate from the Windows store.

# --- Required for every user-flow test -----------------------------------------------------
# Tenant id (GUID) or verified domain.
AZURE_AUTH_TEST_TENANT_ID=
# The user who signs in for most tests. Needs to be able to consent to the scopes each test
# asks for, so in practice a Global Administrator.
AZURE_AUTH_TEST_USERNAME=

# --- Optional: a second, non-administrator user in the same tenant ---------------------------
# Only used by the consent test. An administrator can always consent, so the consent-failure
# path can only be reached by a user who cannot. This user needs no roles and no licences; it
# only has to be able to sign in. Naming one runs the test; leaving it blank skips it.
# The test also needs consent revoked first: scripts/revoke_consent.py.
AZURE_AUTH_TEST_NONADMIN_USERNAME=

# --- Optional: set to 1 to enable ------------------------------------------------------------
# The user may sign in to Microsoft Graph Command Line Tools in the tenant. The Graph tests and
# the consent baseline need it; a tenant that blocks the application runs the rest.
AZURE_AUTH_TEST_GRAPH=
# The user can see at least one Azure subscription. A tenant with no Azure access still
# answers /subscriptions with an empty list, so the test cannot tell the difference itself.
AZURE_AUTH_TEST_ARM=
# The user is a partner user with GDAP customers.
AZURE_AUTH_TEST_GDAP=
# The user may run Exchange Online cmdlets (Get-OrganizationConfig).
AZURE_AUTH_TEST_EXCHANGE=
# The user may run Security & Compliance cmdlets (Get-Label).
AZURE_AUTH_TEST_IPPS=

# --- Optional: Key Vault -------------------------------------------------------------------
# A vault in the tenant above, and the name of a secret in it the user may read (the Key Vault
# Secrets User role, or an access policy with Get on secrets). The name goes here, never the
# value. Make a secret for the tests with a throwaway value: the tests read it, though they
# never print it. Naming both runs the Key Vault tests, and the Azure PowerShell sign-in they
# use.
AZURE_AUTH_TEST_KEYVAULT_URL=
AZURE_AUTH_TEST_KEYVAULT_SECRET_NAME=

# --- Optional: app flow with a certificate in Cert:\CurrentUser\My ---------------------------
# Your own app registration, with the Graph application permission Organization.Read.All
# and the certificate's public key uploaded to it.
AZURE_AUTH_TEST_APP_CLIENT_ID=
AZURE_AUTH_TEST_CERT_THUMBPRINT=
