# Settings for the live tests in tests/live/. Copy to .env and fill in.
# Run with:  uv run --env-file .env pytest tests/live -s --no-cov
# No secret belongs in this file. App-flow tests use a certificate from the Windows store,
# or a client secret from the keyring.

# --- Required for every user-flow test -----------------------------------------------------
# Tenant id (GUID) or verified domain.
AZURE_AUTH_TEST_TENANT_ID=
# The user who signs in for most tests, in practice a Global Administrator.
AZURE_AUTH_TEST_USERNAME=

# --- Optional: a second, non-administrator user in the same tenant ---------------------------
# A user who cannot consent, for the consent test.
AZURE_AUTH_TEST_NONADMIN_USERNAME=

# --- Optional: set to 1 to enable ------------------------------------------------------------
# The user may sign in to Microsoft Graph Command Line Tools in the tenant.
AZURE_AUTH_TEST_GRAPH=
# The user can see at least one Azure subscription.
AZURE_AUTH_TEST_ARM=
# The user is a partner user with GDAP customers.
AZURE_AUTH_TEST_GDAP=
# The user may run Exchange Online cmdlets (Get-OrganizationConfig).
AZURE_AUTH_TEST_EXCHANGE=
# The user may run Security & Compliance cmdlets (Get-Label).
AZURE_AUTH_TEST_IPPS=
# The user is signed in to the Windows broker on this device.
AZURE_AUTH_TEST_BROKER=

# --- Optional: a browser other than the system default -------------------------------------
# Every browser sign-in opens in it. A JSON array: the program, then any arguments. Use forward slashes in the path, and single
# quotes around the whole value, or the double quotes inside it are stripped. Give at least
# one argument, so the test covers passing them. Edge's --profile-directory takes the
# profile's folder name under %LOCALAPPDATA%\Microsoft\Edge\User Data, not its display name.
# AZURE_AUTH_TEST_BROWSER='["C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe", "--profile-directory=Profile 1"]'
AZURE_AUTH_TEST_BROWSER=

# --- Optional: token cache reminder ----------------------------------------------------------
# Path to place reminder to delete testing token cache. Single-quote a path with spaces.
AZURE_AUTH_TEST_CACHE_REMINDER_PATH=

# --- Optional: GDAP customer tenants ---------------------------------------------------------
# Customer tenant ids or domains reached through GDAP, separated by commas.
AZURE_AUTH_TEST_GDAP_TENANT_IDS=
# The one GDAP test that WRITES to a customer tenant has no setting here: pass
# --grant-when-possible to pytest, every time you want it.

# --- Optional: Key Vault -------------------------------------------------------------------
# A vault in the tenant, and the name of a throwaway secret the user may read.
AZURE_AUTH_TEST_KEYVAULT_URL=
AZURE_AUTH_TEST_KEYVAULT_SECRET_NAME=

# --- Optional: app flow with a certificate in Cert:\CurrentUser\My ---------------------------
# An app with Graph Organization.Read.All, and the thumbprint of the certificate uploaded to it.
AZURE_AUTH_TEST_APP_CLIENT_ID=
AZURE_AUTH_TEST_CERT_THUMBPRINT=
# A second certificate uploaded to the same app, in Cert:\LocalMachine\My.
AZURE_AUTH_TEST_MACHINE_CERT_THUMBPRINT=

# --- Optional: app flow with a client secret in the keyring ----------------------------------
# The keyring service and username a client secret of the same app is stored under.
# On Windows, save it as a generic credential:  cmdkey /generic:<service> /user:<username> /pass
AZURE_AUTH_TEST_APP_SECRET_SERVICE=
AZURE_AUTH_TEST_APP_SECRET_USERNAME=
